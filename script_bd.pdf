-- 1. Crear la base de datos
CREATE DATABASE fitness_db;

-- 2. Crear usuario con contraseña
CREATE USER 'fitness_user'@'%' IDENTIFIED BY 'tu_password_seguro';

-- 3. Conceder todos los privilegios sobre la base de datos al usuario
GRANT ALL PRIVILEGES ON fitness_db.* TO 'fitness_user'@'%';

-- 4. Aplicar los cambios de permisos
FLUSH PRIVILEGES;